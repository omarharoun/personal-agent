# --- Gradle ---
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# --- IntelliJ / Android Studio ---
.idea/
*.iml
captures/
.kotlin/

# --- Android ---
*.apk
*.aab
*.ap_
*.dex
release/

# --- Kotlin/Native + KMP ---
*.klib
kotlin-js-store/

# --- On-device ML model assets (provisioned via Gradle, not committed) ---
# all-MiniLM-L6-v2 weights (~90 MB) + vocab — fetched by
# `./gradlew :androidApp:downloadEmbeddingModel`. See README "On-device embeddings".
androidApp/src/main/assets/models/

# --- Xcode / iOS ---
# The .xcodeproj is generated from iosApp/project.yml (XcodeGen) — do not commit it.
iosApp/*.xcodeproj/
iosApp/*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm/
Pods/

# --- On-device ML models (Step 2 embeddings) ---
# The iOS embedder uses Apple NaturalLanguage (no shipped model). If a converted
# Core ML model (e.g. all-MiniLM-L6-v2) is ever added, it must NOT be committed —
# it would be provisioned per iosApp/README. Keep large model binaries out of git:
*.mlmodel
*.mlmodelc
*.mlpackage
*.onnx
*.tflite

# --- On-device LLM models (Step 3) ---
# Small LLM weights (.task / .bin / .litertlm, ~0.5–2 GB) are pushed to the
# device, never committed and never packaged in the APK. See README "On-device
# LLM" and LlmModelProvisioning.
*.task
*.litertlm
androidApp/src/main/assets/models/llm/

# --- macOS / misc ---
.DS_Store
*.log
