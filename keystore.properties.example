# Android release signing — TEMPLATE. Copy to `keystore.properties` (repo root)
# and fill in your real values. `keystore.properties` and `*.jks/*.keystore` are
# gitignored and must NEVER be committed.
#
#   cp keystore.properties.example keystore.properties
#   # then edit keystore.properties with your release key details
#
# Create a release keystore once (keep it + these passwords safe and backed up —
# losing them means you can never update the app under the same key, unless you
# use Play App Signing):
#
#   keytool -genkeypair -v -keystore release.jks \
#     -alias personal-agent -keyalg RSA -keysize 2048 -validity 10000
#
# When keystore.properties is ABSENT, the release build falls back to DEBUG
# signing so it still compiles in CI/sandbox — that artifact is NOT uploadable.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=personal-agent
keyPassword=CHANGE_ME
